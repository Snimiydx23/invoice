# Google Gemini API Key (for AI-powered invoice extraction)
# Get your FREE API key from: https://aistudio.google.com/apikey
# Free tier: 1500 requests/day
# This is REQUIRED for production deployment on Vercel
GEMINI_API_KEY="your-gemini-api-key-here"

# ✅ FIX: Render backend ka URL — Vercel mein environment variable set karo
# Yeh Vercel ke dashboard > Settings > Environment Variables mein add karo
# Value: https://invoice-api-server.onrender.com  (ya aapka actual Render URL)
NEXT_PUBLIC_BACKEND_URL="https://invoice-api-server.onrender.com"

# NOTE: If GEMINI_API_KEY is not set, the app will try z-ai-web-dev-sdk (sandbox only)
# For production deployment on Vercel, GEMINI_API_KEY is REQUIRED

# DATABASE_URL is optional - only needed if using Prisma/SQLite for local development
# DATABASE_URL="file:./dev.db"
